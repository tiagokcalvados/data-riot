{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "buildCommand": "npm run build",
  "rewrites": [
    {
      "source": "/",
      "has": [{ "type": "query", "key": "v", "value": "20261119" }],
      "destination": "/share-v20261119.html"
    }
  ],
  "redirects": [
    { "source": "/watch", "destination": "/", "permanent": true },
    { "source": "/watch.html", "destination": "/", "permanent": true },
    { "source": "/sound-lab", "destination": "/", "permanent": true },
    { "source": "/sound-lab.html", "destination": "/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/data-riot-front-page.png",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=3600" }
      ]
    }
  ]
}
